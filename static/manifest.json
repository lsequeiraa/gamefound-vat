{
  "manifest_version": 3,
  "name": "VAT Included for Gamefound",
  "version": "0.0.0",
  "description": "Unofficial. Shows Gamefound reward and add-on prices with the VAT for your delivery country included.",
  "homepage_url": "https://github.com/lsequeiraa/gamefound-vat",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://gamefound.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "VAT Included for Gamefound",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "gamefound-vat@lsequeiraa",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
